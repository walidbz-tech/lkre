# Mode de stockage : "file" (routes API + data/db.json) ou "local" (localStorage, GitHub Pages)
NEXT_PUBLIC_STORAGE_MODE=file

# Secret de signature des sessions (mode file). 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Dossier du fichier JSON (optionnel, défaut : ./data)
# LKRE_DATA_DIR=./data
